generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  position  Position[]
  history   history[]
  wallet    wallet?
  orders    Order[]
}

model Market {
  id        String          @id @default(uuid())
  symbol    String
  position  Position[]
}
model Position{
  id        String          @id @default(uuid())
  side      PositionSide
  qty       Float
  price     Float
  userId    String
  marketId  String
  user      User            @relation(fields: [userId], references: [id])
  market    Market          @relation(fields: [marketId], references: [id])
}

enum PositionSide {
  buy
  sell
}

model history {
  id        String          @id @default(uuid())
  side      PositionSide
  qty       Float
  price     Float
  exitPrice Float
  userId    String
  user      User            @relation(fields: [userId], references: [id])
}

model wallet {
  id        String          @id @default(uuid())
  balance   Float           @default(0)
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id])
}

enum OrderSide {
  buy
  sell
}

enum OrderType {
  market
  limit
}

enum OrderStatus {
  pending
  open
  partially_filled
  filled
  cancelled
  rejected
}

model Order {
  id        String      @id
  userId    String
  symbol    String
  side      OrderSide
  type      OrderType
  price     Float
  qty       Float
  filledQty Float       @default(0)
  status    OrderStatus @default(pending)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([symbol])
}